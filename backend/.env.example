# ---------------------------------------------------------------- Supabase
# Project Settings -> Data API
SUPABASE_URL=https://benvidirtbvfwyoohlyd.supabase.co
# Project Settings -> API Keys -> publishable (safe to expose)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ymS8sLXc-p9E7iC5NNH6hg_aJAkDtxg
# Project Settings -> API Keys -> secret / service_role.  SERVER ONLY, never in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings -> Database -> Connection string -> Session pooler.
# Press "Reset database password" there first, then paste the string with the password in it.
DATABASE_URL=postgresql://postgres.benvidirtbvfwyoohlyd:YOUR-DB-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------- app
PORT=4000
# Where the web app runs. Several origins can be listed, separated by commas.
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------- WhatsApp host alerts (optional)
# Paste the webhook URL from your Make.com scenario to turn alerts on.
MAKE_WEBHOOK_URL=
MAKE_WEBHOOK_SECRET=
